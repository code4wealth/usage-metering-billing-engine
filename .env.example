# Copy to .env and fill in locally. Never commit .env. All values below are dummies.
APP_ENV=development
LOG_LEVEL=INFO
# Database
POSTGRES_USER=metering
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=metering
DATABASE_URL=postgresql+psycopg://metering:change_me_locally@localhost:5432/metering
# API keys
API_KEY_PREFIX_LABEL=ume
# Idempotency claim lease (seconds); stale in_progress claims can be taken over after this TTL
IDEMPOTENCY_CLAIM_TTL_SECONDS=60
# Completed idempotency rows are retained this long after completion (hours)
IDEMPOTENCY_RETENTION_HOURS=24
# Billing configuration (development placeholders; no production defaults invented)
# 20000000 micro-dollars = $20 development placeholder; must match the Stripe test price amount
PRO_PRICE_MICRO_USD=20000000
# Arbitrary dev values, not real prices; deliberately not multiples of 1,000,000 so half-up rounding is exercised
INPUT_RATE_MICRO_PER_MILLION=1500000
OUTPUT_RATE_MICRO_PER_MILLION=3500000
# Stripe (TEST MODE ONLY)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRO_PRICE_ID=price_xxx
# Rate limiting
RATE_LIMIT_PER_MINUTE=120
# Per-hour per-IP limit for public POST /tenants (default 10)
SIGNUP_RATE_LIMIT_PER_HOUR_PER_IP=10
