# Copy to .env and fill in locally. Never commit .env. All values below are dummies.
APP_ENV=development
LOG_LEVEL=INFO
# Database
POSTGRES_USER=metering
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=metering
DATABASE_URL=postgresql+psycopg://metering:change_me_locally@localhost:5432/metering
# API keys
API_KEY_PREFIX_LABEL=ume
# Billing configuration (no defaults invented; set deliberately)
PRO_PRICE_MICRO_USD=
INPUT_RATE_MICRO_PER_MILLION=
OUTPUT_RATE_MICRO_PER_MILLION=
# Stripe (TEST MODE ONLY)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRO_PRICE_ID=price_xxx
# Rate limiting
RATE_LIMIT_PER_MINUTE=120
